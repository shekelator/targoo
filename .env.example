# Copy to .env, fill in, and load with:  set -a; source .env; set +a
# (Never commit a filled-in .env — it is gitignored.)

# Ollama Cloud API key (https://ollama.com), read by the provider named in:
#   providers.<name>.api_key_env  — default OLLAMA_API_KEY
OLLAMA_API_KEY=

# AWS credentials for Bedrock come from the standard chain — pick ONE:
#   - SSO:        aws sso login --profile <profile>, then:
AWS_PROFILE=
#   - or explicit keys:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Region override (targoo.yaml's aws_region is passed explicitly, but the AWS
# env var is useful for `aws bedrock ...` CLI calls):
AWS_REGION=